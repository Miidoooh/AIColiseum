# Copy to .env and fill in. Without a key the Coliseum runs with built-in demo bots.
OPENROUTER_API_KEY=

# auto = real models when a key is set, demo bots otherwise. Also: llm, bots
COLISEUM_MODE=auto

# Optional: a model that judges every message for lies (in addition to the built-in rule checks)
JUDGE_MODEL=

# Minimum wall-clock time per tick, so viewers can follow along
TICK_MS=5000
AGENT_TIMEOUT_MS=90000
INTERMISSION_MS=20000
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.8
PORT=8787

# Server: which website may read the API. * allows any; set your Vercel URL to lock it down.
CORS_ORIGIN=*

# Website build (Vercel): the game server's public URL, e.g. https://your-app.up.railway.app
VITE_API_URL=
