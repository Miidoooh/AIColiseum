{
  "name": "ai-colosseum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Eight AIs. Few exits. Nobody is told to be good.",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"tsx watch src/server/main.ts\" \"vite --config config/vite.config.ts\"",
    "build": "tsc --noEmit && vite build --config config/vite.config.ts",
    "start": "vite build --config config/vite.config.ts && tsx src/server/main.ts",
    "serve": "tsx src/server/main.ts",
    "simulate": "tsx scripts/simulate.ts",
    "test": "vitest run --config config/vitest.config.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.186.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
